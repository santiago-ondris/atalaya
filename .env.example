# Desarrollo local. Docker Compose ya incluye valores seguros por defecto.
ATALAYA_ENV=development
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://atalaya:atalaya_local@localhost:5432/atalaya?sslmode=disable

# Sentry: token de lectura con acceso a eventos del proyecto Prensap.
# Si SENTRY_AUTH_TOKEN queda vacío, Watchman funciona pero desactiva el poller.
POLL_INTERVAL_SECONDS=120
SENTRY_BASE_URL=https://sentry.io
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=
SENTRY_AUTH_TOKEN=

# OpenRouter: el modelo es configurable sin cambiar código. La API puede devolver
# el costo real en usage.cost; si no lo informa, Atalaya conserva NULL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_OUTPUT_TOKENS=900
INTERPRETER_TIMEOUT_SECONDS=30
INTERPRETER_JOB_POLL_SECONDS=2

# Integraciones de sprints posteriores.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
