# Desarrollo local. Docker Compose ya incluye valores seguros por defecto.
ATALAYA_ENV=development
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://atalaya:atalaya_local@localhost:5432/atalaya?sslmode=disable

# Sentry: token de lectura con acceso a eventos del proyecto Prensap.
# Si SENTRY_AUTH_TOKEN queda vacío, Watchman funciona pero desactiva el poller.
POLL_INTERVAL_SECONDS=120
SENTRY_BASE_URL=https://sentry.io
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=
SENTRY_AUTH_TOKEN=

# Integraciones de sprints posteriores.
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
