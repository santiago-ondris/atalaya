# Desarrollo local. Docker Compose ya incluye valores seguros por defecto.
ATALAYA_ENV=development
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://atalaya:atalaya_local@localhost:5432/atalaya?sslmode=disable

# Command Center. Generar un hash Argon2id para la contraseña elegida; nunca
# guardar la contraseña en texto. En compose local, si se omite, la contraseña
# segura de ejemplo es "atalaya_local". COOKIE_SECURE debe ser true en producción.
ATALAYA_ADMIN_PASSWORD_HASH=
ATALAYA_COOKIE_SECURE=false
ATALAYA_SESSION_DURATION_SECONDS=86400

# Sentry: un token de lectura con acceso a los seis proyectos de la organización.
# Los proyectos y ambientes están en apps/watchman/config/sentry-integrations.json.
# Si SENTRY_AUTH_TOKEN queda vacío, Watchman funciona pero desactiva los pollers.
POLL_INTERVAL_SECONDS=120
SENTRY_BASE_URL=https://sentry.io
SENTRY_ORG_SLUG=
SENTRY_AUTH_TOKEN=
SENTRY_CATALOG_PATH=config/sentry-integrations.json

# OpenRouter: el modelo es configurable sin cambiar código. La API puede devolver
# el costo real en usage.cost; si no lo informa, Atalaya conserva NULL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_OUTPUT_TOKENS=900
INTERPRETER_TIMEOUT_SECONDS=30
INTERPRETER_JOB_POLL_SECONDS=2

# Telegram: ambos valores deben configurarse juntos. El chat ID corresponde al
# chat privado que previamente inició una conversación con el bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_JOB_POLL_SECONDS=2
TELEGRAM_DEDUP_WINDOW_SECONDS=900
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=600
TELEGRAM_RATE_LIMIT_PER_APP=10
TELEGRAM_INTERPRETER_ALERT_COOLDOWN_SECONDS=1800
DAILY_REPORT_SCHEDULER_SECONDS=30
DAILY_REPORT_WORKER_ID=watchman-daily-report-1
# Se omite hasta que Watchman tenga una URL pública navegable.
ATALAYA_PUBLIC_URL=

# Ingesta de deploy markers. Usar secretos aleatorios distintos. El primero se
# envía como Bearer token desde GitHub Actions; el segundo forma parte de la URL
# configurada en los webhooks nativos de Railway.
DEPLOYMENT_INGEST_TOKEN=
RAILWAY_WEBHOOK_TOKEN=

# Application Insights / Log Analytics para Notizap. Los cuatro valores son
# obligatorios en conjunto. El service principal necesita Reader sobre el workspace.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
AZURE_APPLICATION_INSIGHTS_RESOURCE_ID=
AZURE_QUERY_OVERLAP_SECONDS=300
NOTIZAP_COMPONENT=backend
NOTIZAP_DISPLAY_NAME=Backend
NOTIZAP_ENVIRONMENT=production
